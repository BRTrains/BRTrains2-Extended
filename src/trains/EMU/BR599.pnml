// unit definition
item (FEAT_TRAINS, item_BR599, 5990) {
    property {
        // common properties
        name:                           string(STR_NAME_BR599);
        // variant_group:                  ; // unit ID or item
		// extra_flags:                    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
        extra_flags:                    bitmask(VEHICLE_FLAG_TRAIN_HAS_CAB);

        climates_available:             ALL_CLIMATES;
        introduction_date:              date(1975,01,01); 
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life: 					40;
        retire_early: 					-10;							
        reliability_decay: 				20;
        
		refittable_cargo_classes:        bitmask(CC_PASSENGERS);
        // non_refittable_cargo_classes:    bitmask();
        cargo_allow_refit:               [PASS, TOUR];
        // cargo_disallow_refit:            [LVST];
        misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
        cargo_capacity:                 42 * param_pax;
        loading_speed:					24; // Standard Class
        running_cost_base:			    RUNNING_COST_STEAM;		

        //specific properties
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        speed:                          50 mph;
        refit_cost:                     0;
        track_type:                     ELRL; // 25kv until the 1.5kV update
        // track_type:                     ; // custom track type defined
        power:                          248 hp;
        weight:                         40 ton;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        dual_headed:                    0;
        air_drag_coefficient:           0.12;
        tractive_effort_coefficient:    0.15;
        length:                         3;
    }

    graphics {
        // graphics
        default:                        sw_livery_BR599;
        visual_effect_and_powered:      sw_FX_BR599_OHLE;
        purchase:                       sw_BR599_purchase_sprite;
        sound_effect:                   sw_sound_electric_GEC;

        // internal code
        articulated_part:               sw_articulated_BR599;
        cost_factor:                    339;
        running_cost_factor:            3291;
        cargo_subtype_text:             sw_BR599_cargo_subtype_text; 
        // power:                          sw_power_BR599;
        colour_mapping:                 return PALETTE_CC_FIRST;
        // colour_mapping:                 switch_generic_recolour;
    }
}