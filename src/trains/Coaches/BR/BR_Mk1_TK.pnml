    0: sw_loadstack_BR_Mk1_TK_BR_BnC;
    1: sw_loadstack_BR_Mk1_TK_BR_CnC;
    2: sw_loadstack_BR_Mk1_TK_BR_Southern_Green;
    3: sw_loadstack_BR_Mk1_TK_BR_Maroon;
    4: sw_loadstack_BR_Mk1_TK_BR_Blue;
    5: sw_loadstack_BR_Mk1_TK_InterCity;
    6: sw_loadstack_BR_Mk1_TK_NSE;
    7: sw_loadstack_BR_Mk1_TK_RegionalRailways;
    8: sw_loadstack_BR_Mk1_TK_WestCoastRailway;
}

// livery name refit switch
switch(FEAT_TRAINS, SELF, sw_BR_Mk1_TK_cargo_subtype_text, cargo_subtype){
    0:  string(STR_LIVERY_DESC, string(str_BR), string(str_BR_CarmineCream));
    1:  string(STR_LIVERY_DESC, string(str_BR), string(str_col_ChocCream));
    2:  string(STR_LIVERY_DESC, string(str_BR), string(str_col_Malachite));
	3:	string(STR_LIVERY_DESC, string(str_BR), string(str_col_Maroon));
    4:  string(STR_LIVERY_DESC, string(str_BR), string(str_BR_BlueGrey));
    5:  string(STR_LIVERY_DESC, string(str_BR), string(str_BR_InterCity));
    6:  string(STR_LIVERY, string(str_NSE));
    7:  string(STR_LIVERY, string(str_Regional));
    8:  string(STR_LIVERY, string(str_WestCoast));
        CB_RESULT_NO_TEXT; }

// graphics switch
switch(FEAT_TRAINS, SELF, sw_spritestack_BR_Mk1_TK_Bogie, [ STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8) ] ) {
    0: sw_livery_BR_Mk1_TK;
    1: sw_BR_Mk1_Pick_Bogie; }

switch(FEAT_TRAINS, SELF, switch_BR_Mk1_TK_graphics, position_in_articulated_veh % 3) {
	1:  sw_spritestack_BR_Mk1_TK_Bogie;
	    spriteset_empty;
}

// articulation switch
switch(FEAT_TRAINS, SELF, switch_articulated_BR_Mk1_TK, extra_callback_info1) {
	1..2: return item_BR_Mk1_TK;
		return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// year name switch
switch(FEAT_TRAINS, PARENT, sw_BR_Mk1_TK_name, current_year) {
    0..1956: string(STR_NAME_BR_Mk1_TK);
             string(STR_NAME_BR_Mk1_SK);
}

switch(FEAT_TRAINS, PARENT, sw_BR_Mk1_TK_desc, current_year) {
    0..1956: string(str_purchase_coach, string(str_coach_TK));
             string(str_purchase_coach, string(str_coach_SK)); }

item (FEAT_TRAINS, item_BR_Mk1_TK, 12031) { // Diagram 146/147 BR Mk1 TK/SK
    property {
		// common properties
        name:                           string(STR_NAME_BR_Mk1_TK);
        variant_group:                  item_BR_Mk1_Header; // unit ID or item

        climates_available:              ALL_CLIMATES;
		introduction_date:				date(1951,01,01);
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life: 					40;
        retire_early: 					-10;							
        reliability_decay: 				20;
		refittable_cargo_classes:		bitmask(CC_PASSENGERS);
        cargo_allow_refit:              [PASS, TOUR];
        misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);
        cargo_capacity:                 21 * param_pax;
        loading_speed:					15;
        running_cost_base:			    RUNNING_COST_STEAM;		
		
        //specific properties
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        speed:                          100 mph;
        refit_cost:                     0;
        track_type:                     RAIL;
        weight:                         33 ton;
        length:                         4;
	}
    
	graphics {
        // graphics
        default:                        switch_BR_Mk1_TK_graphics;
        purchase:                       sw_spritestack_BR_Mk1_TK_purchase;

        // internal code
        name:                           sw_BR_Mk1_TK_name;
        articulated_part:               switch_articulated_BR_Mk1_TK;
        purchase_cargo_capacity:        return (21 * param_pax); // divide by number of articulated parts and floor
        cost_factor:                    1163;
        running_cost_factor:            1404;
        cargo_subtype_text:             sw_BR_Mk1_TK_cargo_subtype_text; 
        colour_mapping:                 return PALETTE_CC_FIRST;

        // purchase menu text
        additional_text:                sw_BR_Mk1_TK_desc;
    }
}

// articulation switch
switch(FEAT_TRAINS, SELF, switch_articulated_BR_Mk1_SO, extra_callback_info1) {
	1..2: return item_BR_Mk1_SO;
