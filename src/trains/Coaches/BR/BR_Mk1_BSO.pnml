switch(FEAT_TRAINS, SELF, sw_loadstack_BR_Mk1_BSO_RegionalRailways, [ STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8) ] ) {
    0: spriteset_BR_Mk1_BSO_RegionalRailways;
    1: spritegroup_BR_Mk1_BSO_RegionalRailways_Loading;
    2: sw_BR_Mk1_Pick_Bogie_Expensive; }

// basic sprite
spriteset(spriteset_BR_Mk1_BSO_RegionalRailways_REV, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx/Coaches/BR_Mk1_BSO/BR_Mk1_BSO_RegionalRailways_32bpp.png", "gfx/Coaches/BR_Mk1_BSO/BR_Mk1_BSO_RegionalRailways_mask.png")
    { template_128trains_REV_4x(0,0) }

spriteset(spriteset_BR_Mk1_BSO_RegionalRailways_Loading_REV, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx/Coaches/BR_Mk1_BSO/BR_Mk1_BSO_RegionalRailways_Loading_32bpp.png", "gfx/Coaches/BR_Mk1_BSO/BR_Mk1_BSO_RegionalRailways_Loading_mask.png")
    { template_128trains_REV_4x(0,0) }

// loading sprite
spritegroup spritegroup_BR_Mk1_BSO_RegionalRailways_Loading_REV {  
    loaded: [spriteset_empty];
    loading: [spriteset_BR_Mk1_BSO_RegionalRailways_Loading_REV]; }

switch(FEAT_TRAINS, SELF, sw_loadstack_BR_Mk1_BSO_RegionalRailways_REV, [ STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8) ] ) {
    0: spriteset_BR_Mk1_BSO_RegionalRailways_REV;
    1: spritegroup_BR_Mk1_BSO_RegionalRailways_Loading_REV;
    2: sw_BR_Mk1_Pick_Bogie_Expensive; }

// basic sprite
spriteset(spriteset_BR_Mk1_BSO_WestCoastRailway, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx/Coaches/BR_Mk1_BSO/BR_Mk1_BSO_WestCoastRailway_32bpp.png", "gfx/Coaches/BR_Mk1_BSO/BR_Mk1_BSO_WestCoastRailway_mask.png")
    { template_128trains_4x(0,0) }

spriteset(spriteset_BR_Mk1_BSO_WestCoastRailway_Loading, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx/Coaches/BR_Mk1_BSO/BR_Mk1_BSO_WestCoastRailway_Loading_32bpp.png", "gfx/Coaches/BR_Mk1_BSO/BR_Mk1_BSO_WestCoastRailway_Loading_mask.png")
    { template_128trains_4x(0,0) }

// loading sprite
spritegroup spritegroup_BR_Mk1_BSO_WestCoastRailway_Loading {  
    loaded: [spriteset_empty];
    loading: [spriteset_BR_Mk1_BSO_WestCoastRailway_Loading]; }

switch(FEAT_TRAINS, SELF, sw_loadstack_BR_Mk1_BSO_WestCoastRailway, [ STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8) ] ) {
    0: spriteset_BR_Mk1_BSO_WestCoastRailway;
    1: spritegroup_BR_Mk1_BSO_WestCoastRailway_Loading;
    2: sw_BR_Mk1_Pick_Bogie_Expensive; }

// basic sprite
spriteset(spriteset_BR_Mk1_BSO_WestCoastRailway_REV, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx/Coaches/BR_Mk1_BSO/BR_Mk1_BSO_WestCoastRailway_32bpp.png", "gfx/Coaches/BR_Mk1_BSO/BR_Mk1_BSO_WestCoastRailway_mask.png")
    { template_128trains_REV_4x(0,0) }

spriteset(spriteset_BR_Mk1_BSO_WestCoastRailway_Loading_REV, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx/Coaches/BR_Mk1_BSO/BR_Mk1_BSO_WestCoastRailway_Loading_32bpp.png", "gfx/Coaches/BR_Mk1_BSO/BR_Mk1_BSO_WestCoastRailway_Loading_mask.png")
    { template_128trains_REV_4x(0,0) }

// loading sprite
spritegroup spritegroup_BR_Mk1_BSO_WestCoastRailway_Loading_REV {  
    loaded: [spriteset_empty];
    loading: [spriteset_BR_Mk1_BSO_WestCoastRailway_Loading_REV]; }

switch(FEAT_TRAINS, SELF, sw_loadstack_BR_Mk1_BSO_WestCoastRailway_REV, [ STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8) ] ) {
    0: spriteset_BR_Mk1_BSO_WestCoastRailway_REV;
    1: spritegroup_BR_Mk1_BSO_WestCoastRailway_Loading_REV;
    2: sw_BR_Mk1_Pick_Bogie_Expensive; }

// purchase year switch
switch(FEAT_TRAINS, SELF, sw_BR_Mk1_BSO_purchase_sprite, current_year) {
	1948..1956: spriteset_BR_Mk1_BSO_BR_BnC_purchase;
    1966..2002: spriteset_BR_Mk1_BSO_BR_Blue_purchase;
	    spriteset_BR_Mk1_BSO_BR_Maroon_purchase; }

switch(FEAT_TRAINS, SELF, sw_spritestack_BR_Mk1_BSO_purchase, [ STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8) ] ) {
    0: sw_BR_Mk1_BSO_purchase_sprite;
    1: spriteset_BR_Mk1_B1_Bogie_purchase; }

// livery switch
switch(FEAT_TRAINS, SELF, sw_livery_BR_Mk1_BSO, cargo_subtype) {
    0: sw_loadstack_BR_Mk1_BSO_BR_BnC;
    1: sw_loadstack_BR_Mk1_BSO_BR_CnC;
    2: sw_loadstack_BR_Mk1_BSO_BR_Southern_Green;
    3: sw_loadstack_BR_Mk1_BSO_BR_Maroon;
    4: sw_loadstack_BR_Mk1_BSO_BR_Blue;
    5: sw_loadstack_BR_Mk1_BSO_InterCity;
    6: sw_loadstack_BR_Mk1_BSO_NSE;
    7: sw_loadstack_BR_Mk1_BSO_RegionalRailways;
    8: sw_loadstack_BR_Mk1_BSO_WestCoastRailway; }

switch(FEAT_TRAINS, SELF, sw_livery_BR_Mk1_BSO_REV, cargo_subtype) {
    0: sw_loadstack_BR_Mk1_BSO_BR_BnC_REV;
    1: sw_loadstack_BR_Mk1_BSO_BR_CnC_REV;
    2: sw_loadstack_BR_Mk1_BSO_BR_Southern_Green_REV;
    3: sw_loadstack_BR_Mk1_BSO_BR_Maroon_REV;
    4: sw_loadstack_BR_Mk1_BSO_BR_Blue_REV;
    5: sw_loadstack_BR_Mk1_BSO_InterCity_REV;
    6: sw_loadstack_BR_Mk1_BSO_NSE_REV;
    7: sw_loadstack_BR_Mk1_BSO_RegionalRailways_REV;
    8: sw_loadstack_BR_Mk1_BSO_WestCoastRailway_REV; }

// random switch
random_switch(FEAT_TRAINS, SELF, random_choose_reverse_BR_Mk1_BSO) {
    1: sw_livery_BR_Mk1_BSO;
    1: sw_livery_BR_Mk1_BSO_REV; }

// position switch
switch(FEAT_TRAINS, SELF, sw_check_position_BR_Mk1_BSO, position_in_consist) {
    1..7: sw_livery_BR_Mk1_BSO;
        return random_choose_reverse_BR_Mk1_BSO; }

// reverse switch
switch(FEAT_TRAINS, SELF, sw_check_reverse_BR_Mk1_BSO, num_vehs_in_consist >= 6 ? position_in_consist_from_end : -1) {
    1: sw_livery_BR_Mk1_BSO_REV;
        return sw_check_position_BR_Mk1_BSO; }

// livery name refit switch
switch(FEAT_TRAINS, SELF, sw_BR_Mk1_BSO_cargo_subtype_text, cargo_subtype){
    0:  string(STR_LIVERY_DESC, string(str_BR), string(str_BR_CarmineCream));
    1:  string(STR_LIVERY_DESC, string(str_BR), string(str_col_ChocCream));
    2:  string(STR_LIVERY_DESC, string(str_BR), string(str_col_Malachite));
	3:	string(STR_LIVERY_DESC, string(str_BR), string(str_col_Maroon));
    4:  string(STR_LIVERY_DESC, string(str_BR), string(str_BR_BlueGrey));
    5:  string(STR_LIVERY_DESC, string(str_BR), string(str_BR_InterCity));
    6:  string(STR_LIVERY, string(str_NSE));
    7:  string(STR_LIVERY, string(str_Regional));
    8:  string(STR_LIVERY, string(str_WestCoast));
        CB_RESULT_NO_TEXT; }

switch(FEAT_TRAINS, SELF, sw_graphics_BR_Mk1_BSO, position_in_articulated_veh % 3) {
    1: return sw_check_reverse_BR_Mk1_BSO;
        spriteset_empty; }

// capacity switch
switch(FEAT_TRAINS, SELF, sw_capacity_BR_Mk1_BSO, position_in_articulated_veh % 3) {
    0: 38 * param_pax;
    1: 1 * param_pax;
    2: sw_capacity_BR_Mk1_B;
} // total 39 pax, 36 mail

// articulation switch
switch(FEAT_TRAINS, SELF, sw_articulated_BR_Mk1_BSO, extra_callback_info1) {
    1: return item_BR_Mk1_BSO;
    2: return item_BR_Mk1_B;
        return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

// unit definition
item (FEAT_TRAINS, item_BR_Mk1_BSO, 12006) { // Diagram 183, 184 BR Mk1 BSO
    property {
        // common properties
        name:                           string(STR_NAME_BR_Mk1_BSO);
        variant_group:                  item_BR_Mk1_Header; // unit ID or item
		extra_flags:                    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(1955,01,01); 
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life: 					40;
        retire_early: 					-10;							
        reliability_decay: 				20;
        
		refittable_cargo_classes:        bitmask(CC_PASSENGERS);
        // refittable_cargo_classes:        bitmask(CC_PIECE_GOODS, CC_EXPRESS, CC_HAZARDOUS, CC_REFRIGERATED, CC_NON_POURABLE, CC_NEO_BULK, CC_OVERSIZED);	
        // non_refittable_cargo_classes:    bitmask();
        cargo_allow_refit:               [PASS, TOUR];
        // cargo_disallow_refit:            [];
        misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
        cargo_capacity:                 1;
        loading_speed:					10;
        running_cost_base:			    RUNNING_COST_STEAM;		

        //specific properties
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        speed:                          100 mph;
        refit_cost:                     0;
        track_type:                     RAIL;
        weight:                         34 ton;
        dual_headed:                    0;
        length:                         4;
    }

    graphics {
        // graphics
        default:                        sw_graphics_BR_Mk1_BSO;
        purchase:                       sw_spritestack_BR_Mk1_BSO_purchase;
        
        // internal code
        articulated_part:               sw_articulated_BR_Mk1_BSO;
        purchase_cargo_capacity:        return (19 * param_pax); // divide by number of articulated parts and floor
        cargo_capacity:                 sw_capacity_BR_Mk1_BSO;
        cost_factor:                    875;
        running_cost_factor:            1331;
        cargo_subtype_text:             sw_BR_Mk1_BSO_cargo_subtype_text; 
        colour_mapping:                 return PALETTE_CC_FIRST;

        // purchase menu text
        additional_text:                return( string(str_purchase_coach,
                                                    string(str_coach_BSO)));
    }
}