switch(FEAT_TRAINS, SELF, sw_purchase_sprite_BR_Mk1_FK, current_year) {
	1948..1956: spriteset_BR_Mk1_FK_BR_BnC_purchase;
    1966..2002: spriteset_BR_Mk1_FK_BR_Blue_purchase;
        spriteset_BR_Mk1_FK_BR_Maroon_purchase;
}

switch(FEAT_TRAINS, SELF, sw_spritestack_BR_Mk1_FK_purchase, [ STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8) ] ) {
    0: sw_purchase_sprite_BR_Mk1_FK;
    1: spriteset_BR_Mk1_B1_Bogie_purchase; }

// livery switch
switch(FEAT_TRAINS, SELF, sw_livery_BR_Mk1_FK, cargo_subtype) {
    0: sw_loadstack_BR_Mk1_FK_BR_BnC;
    1: sw_loadstack_BR_Mk1_FK_BR_CnC;
    2: sw_loadstack_BR_Mk1_FK_BR_Southern_Green;
    3: sw_loadstack_BR_Mk1_FK_BR_Maroon;
    4: sw_loadstack_BR_Mk1_FK_BR_Blue;
    5: sw_loadstack_BR_Mk1_FK_InterCity;
    6: sw_loadstack_BR_Mk1_FK_NSE;
    7: sw_loadstack_BR_Mk1_FK_RegionalRailways;
    8: sw_loadstack_BR_Mk1_FK_WestCoastRailway;
}

// livery name refit switch
switch(FEAT_TRAINS, SELF, sw_BR_Mk1_FK_cargo_subtype_text, cargo_subtype){
    0:  string(STR_LIVERY_DESC, string(str_BR), string(str_BR_CarmineCream));
    1:  string(STR_LIVERY_DESC, string(str_BR), string(str_col_ChocCream));
    2:  string(STR_LIVERY_DESC, string(str_BR), string(str_col_Malachite));
	3:	string(STR_LIVERY_DESC, string(str_BR), string(str_col_Maroon));
    4:  string(STR_LIVERY_DESC, string(str_BR), string(str_BR_BlueGrey));
    5:  string(STR_LIVERY_DESC, string(str_BR), string(str_BR_InterCity));
    6:  string(STR_LIVERY, string(str_NSE));
    7:  string(STR_LIVERY, string(str_Regional));
    8:  string(STR_LIVERY, string(str_WestCoast));
        CB_RESULT_NO_TEXT; }

// graphics switch
switch(FEAT_TRAINS, SELF, sw_spritestack_BR_Mk1_FK_Bogie, [ STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8) ] ) {
    0: sw_livery_BR_Mk1_FK;
    1: sw_BR_Mk1_Pick_Bogie_Expensive; }

switch(FEAT_TRAINS, SELF, switch_BR_Mk1_FK_graphics, position_in_articulated_veh % 3) {
	1:  sw_spritestack_BR_Mk1_FK_Bogie;
	    spriteset_empty;
}

// capacity switch
switch(FEAT_TRAINS, SELF, sw_capacity_BR_Mk1_FK, position_in_vehid_chain % 3) {
    0: 40 * param_pax; // all the capacity - (vehid chain number - 1)
    1..2: 1 * param_pax;
    // total 42
}

// articulation switch
switch(FEAT_TRAINS, SELF, switch_articulated_BR_Mk1_FK, extra_callback_info1) {
	1..2: return item_BR_Mk1_FK;
		return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

item (FEAT_TRAINS, item_BR_Mk1_FK, 12012) { // Diagram 116 BR Mk1 FK
    property {
		// common properties
        name:                           string(STR_NAME_BR_Mk1_FK);
        variant_group:                  item_BR_Mk1_Header; // unit ID or item

        climates_available:              ALL_CLIMATES;
		introduction_date:				date(1951,01,01);
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life: 					40;
        retire_early: 					-10;							
        reliability_decay: 				20;
		refittable_cargo_classes:		bitmask(CC_PASSENGERS);
        cargo_allow_refit:              [PASS, TOUR];
        misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);
        cargo_capacity:                 1;
        loading_speed:					15;
        running_cost_base:			    RUNNING_COST_STEAM;		
		
        //specific properties
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        speed:                          100 mph;
        refit_cost:                     0;
        track_type:                     RAIL;
        weight:                         36 ton;
        length:                         4;
	}
    
	graphics {
        // graphics
        default:                        switch_BR_Mk1_FK_graphics;
        purchase:                       sw_spritestack_BR_Mk1_FK_purchase;

        // internal code
        articulated_part:               switch_articulated_BR_Mk1_FK;
        purchase_cargo_capacity:        return (14 * param_pax); // divide by number of articulated parts and floor
        cargo_capacity:                 sw_capacity_BR_Mk1_FK;
        cost_factor:                    909;
        running_cost_factor:            1340;
        cargo_subtype_text:             sw_BR_Mk1_FK_cargo_subtype_text; 
        colour_mapping:                 return PALETTE_CC_FIRST;

        // purchase menu text
        additional_text:                string(str_purchase_coach, string(str_coach_FK));
    }
}