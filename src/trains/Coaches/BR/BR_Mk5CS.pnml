    10: sw_loadstack_BR_Mk5CS_SLC_CaledonianSleeper;
    13: sw_loadstack_BR_Mk5CS_SLC_CaledonianSleeper;
    16: sw_loadstack_BR_Mk5CS_SLED_CaledonianSleeper;
    19: sw_loadstack_BR_Mk5CS_RLO_CaledonianSleeper;
    22: sw_loadstack_BR_Mk5CS_BSO_CaledonianSleeper;
        spriteset_empty; }  
        
// livery switch
switch(FEAT_TRAINS, SELF, sw_livery_BR_Mk5CS_Double, cargo_subtype) {
    0: sw_graphics_BR_Mk5CS_Double_CaledonianSleeper; }

// capacity switch
switch(FEAT_TRAINS, SELF, sw_capacity_BR_Mk5CS_Double, position_in_vehid_chain % 24) {
    0:  150 * param_pax; // all the capacity - (vehid chain number)
        1 * param_pax; // total 173
}

// articulation switch
switch(FEAT_TRAINS, SELF, sw_articulated_BR_Mk5CS_Double, extra_callback_info1) {
	1..23: item_BR_Mk5CS_Double;
		CB_RESULT_NO_MORE_ARTICULATED_PARTS; }


// unit definition
item (FEAT_TRAINS, item_BR_Mk5CS_Double, 12186) {
    property {
        // common properties
        name:                           string(STR_NAME_BR_Mk5CS_Double);
        variant_group:                  item_BR_Mk5CS_Header; // unit ID or item
		extra_flags:                    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);

        climates_available:             ALL_CLIMATES;
        introduction_date:              date(2016,01,01); 
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life: 					40;
        retire_early: 					-10;							
        reliability_decay: 				20;
        
		refittable_cargo_classes:        bitmask(CC_PASSENGERS);
        // non_refittable_cargo_classes:    bitmask();
        cargo_allow_refit:               [PASS, TOUR];
        // cargo_disallow_refit:            [LVST];
        misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
        cargo_capacity:                 1;
        loading_speed:				    80; // First Class / Restaurant
        running_cost_base:			    RUNNING_COST_STEAM;		

        //specific properties
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        speed:                          100 mph;
        refit_cost:                     0;
        track_type:                     RAIL;
        weight:                         344 ton;
        dual_headed:                    0;
        length:                         8;
    }

    graphics {
        // graphics
        default:                        sw_livery_BR_Mk5CS_Double;
        purchase:                       spriteset_BR_Mk5CS_SLC_CaledonianSleeper_purchase;

        // internal code
        length:                         sw_length_BR_Mk5CS;
        articulated_part:               sw_articulated_BR_Mk5CS_Double;
        purchase_cargo_capacity:        return (7 * param_pax); // divide by number of articulated parts and floor
        cargo_capacity:                 sw_capacity_BR_Mk5CS_Double;
        cost_factor:                    2652;
        running_cost_factor:            2052;
        cargo_subtype_text:             sw_BR_Mk5CS_cargo_subtype_text; 
        colour_mapping:                 return PALETTE_CC_FIRST;
    }
}

