// unit definition
item (FEAT_TRAINS, item_BR_Mk5CS_Header, 12180) {
    property {
        // common properties
        name:                           string(STR_NAME_BR_Mk5CS_Header);
        climates_available:             NO_CLIMATE;
        introduction_date:              date(2016,01,01); 
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
    }

    graphics {
        // graphics
        purchase:                       spriteset_BR_Mk5CS_SLC_CaledonianSleeper_purchase;
        colour_mapping:                 return PALETTE_CC_FIRST;
    }
}



// livery name refit switch
switch(FEAT_TRAINS, SELF, sw_BR_Mk5CS_cargo_subtype_text, cargo_subtype){
	0:	string(STR_LIVERY, string(str_Caledonian));
        CB_RESULT_NO_TEXT; }

// length switch
switch(FEAT_TRAINS, SELF, sw_length_BR_Mk5CS, position_in_articulated_veh % 3) {
	1: 6;
	    4; }

// livery switch
switch(FEAT_TRAINS, SELF, sw_livery_BR_Mk5CS_BSO, cargo_subtype) {
    0: sw_loadstack_BR_Mk5CS_BSO_CaledonianSleeper; }

// graphics switch
switch(FEAT_TRAINS, SELF, sw_graphics_BR_Mk5CS_BSO, position_in_articulated_veh % 3) {
	1:  sw_livery_BR_Mk5CS_BSO;
	    spriteset_empty; }

// capacity switch
switch(FEAT_TRAINS, SELF, sw_capacity_BR_Mk5CS_BSO, position_in_vehid_chain % 3) {
    0: 29 * param_pax; // all the capacity - (vehid chain number)
        1 * param_pax; }

// articulation switch
switch(FEAT_TRAINS, SELF, sw_articulated_BR_Mk5CS_BSO, extra_callback_info1) {
	1..2:item_BR_Mk5CS_BSO;
		CB_RESULT_NO_MORE_ARTICULATED_PARTS; }


// unit definition
item (FEAT_TRAINS, item_BR_Mk5CS_BSO, 12181) {
    property {
        // common properties
        name:                           string(STR_NAME_BR_Mk5CS_BSO);
        variant_group:                  item_BR_Mk5CS_Header; // unit ID or item
		extra_flags:                    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);

        climates_available:             ALL_CLIMATES;
        introduction_date:              date(2016,01,01); 
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life: 					40;
        retire_early: 					-10;							
        reliability_decay: 				20;
        
		refittable_cargo_classes:        bitmask(CC_PASSENGERS);
        // non_refittable_cargo_classes:    bitmask();
        cargo_allow_refit:               [PASS, TOUR];
        // cargo_disallow_refit:            [LVST];
        misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
        cargo_capacity:                 1;
        loading_speed:				    10; // First Class / Restaurant
        running_cost_base:			    RUNNING_COST_STEAM;		

        //specific properties
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        speed:                          100 mph;
        refit_cost:                     0;
        track_type:                     RAIL;
        weight:                         43 ton;
        dual_headed:                    0;
        length:                         8;
    }

    graphics {
        // graphics
        default:                        sw_graphics_BR_Mk5CS_BSO;
        purchase:                       spriteset_BR_Mk5CS_BSO_CaledonianSleeper_purchase;

        // internal code
        length:                         sw_length_BR_Mk5CS;
        articulated_part:               sw_articulated_BR_Mk5CS_BSO;
        purchase_cargo_capacity:        return (10 * param_pax); // divide by number of articulated parts and floor
        cargo_capacity:                 sw_capacity_BR_Mk5CS_BSO;
        cost_factor:                    894;
        running_cost_factor:            1565;
        cargo_subtype_text:             sw_BR_Mk5CS_cargo_subtype_text; 
        colour_mapping:                 return PALETTE_CC_FIRST;

        // purchase menu text
        additional_text:                return(	string(str_purchase_coach,
                                                string(str_coach_BSO)));
    }
}



