// purchase sprite
spriteset(spriteset_BR_Mk1_TK_BR_Blue_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx/Coaches/BR_Mk1_TK/BR_Mk1_TK_BR_Blue_4x_32bpp.png", "gfx/Coaches/BR_Mk1_TK/BR_Mk1_TK_BR_Blue_4x_mask.png")
    { template_purchase(0,0) }

// purchase sprite
spriteset(spriteset_BR_Mk1_TK_BR_BnC_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx/Coaches/BR_Mk1_TK/BR_Mk1_TK_BR_BnC_4x_32bpp.png", "gfx/Coaches/BR_Mk1_TK/BR_Mk1_TK_BR_BnC_4x_mask.png")
    { template_purchase(0,0) }

// purchase sprite
spriteset(spriteset_BR_Mk1_TK_BR_Maroon_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx/Coaches/BR_Mk1_TK/BR_Mk1_TK_BR_Maroon_4x_32bpp.png", "gfx/Coaches/BR_Mk1_TK/BR_Mk1_TK_BR_Maroon_4x_mask.png")
    { template_purchase(0,0) }

switch(FEAT_TRAINS, SELF, sw_purchase_sprite_BR_Mk1_TK, current_year) {
	1948..1956: spriteset_BR_Mk1_TK_BR_BnC_purchase;
    1966..2002: spriteset_BR_Mk1_TK_BR_Blue_purchase;
        spriteset_BR_Mk1_TK_BR_Maroon_purchase;
}

switch(FEAT_TRAINS, SELF, sw_spritestack_BR_Mk1_TK_purchase, [ STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8) ] ) {
    0: sw_purchase_sprite_BR_Mk1_TK;
    1: spriteset_BR_Mk1_B1_Bogie_purchase; }

item(FEAT_TRAINS, item_BR_Mk1_Header, 12000) {
    property {
        name:                           string(STR_NAME_BR_Mk1_Header);
		climates_available: 			NO_CLIMATE;			
        introduction_date:              date(1950,01,01); 		
		sprite_id:						SPRITE_ID_NEW_TRAIN;
	}
	graphics {	
		purchase:						sw_spritestack_BR_Mk1_TK_purchase;
        colour_mapping:                 return PALETTE_CC_FIRST;
	}
}