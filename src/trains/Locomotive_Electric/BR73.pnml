    0:  string(STR_LIVERY_EXTENDED, string(str_BR), string(str_col_Blue), string(str_BR_YellowFront));
    1:  string(STR_LIVERY_EXTENDED, string(str_BR), string(str_col_Blue), string(str_BR_YellowPanel));
    2:  string(STR_LIVERY_DESC, string(str_BR), string(str_BR_LLogo));
    3:  string(STR_LIVERY_DESC, string(str_BR), string(str_BR_InterCity));
    4:  string(STR_LIVERY, string(str_NSE));
    5:  string(STR_LIVERY, string(str_GatEx));
    6:  string(STR_LIVERY_DESC, string(str_BR), string(str_BR_CivilDutch));
    7:  string(STR_LIVERY, string(str_NetworkRail));
    8:  string(STR_LIVERY, string(str_Stagecoach));
    9:  string(STR_LIVERY_DESC, string(str_EWS), string(str_EWS_Red));
    10:  string(STR_LIVERY_DESC, string(str_GBRf), string(str_col_Blue));
    11:  string(STR_LIVERY_DESC, string(str_GBRf), string(str_Southern));
    12:  string(STR_LIVERY_DESC, string(str_GBRf), string(str_FirstGroup));
    13:  string(STR_LIVERY, string(str_Pullman));
        CB_RESULT_NO_TEXT; }

// graphics switch
switch(FEAT_TRAINS, SELF, sw_graphics_BR73_1, position_in_articulated_veh % 3) {
	1: return sw_livery_BR73_1;
	    spriteset_empty; }


// articulation switch
switch(FEAT_TRAINS, SELF, sw_articulated_BR73_1, extra_callback_info1) {
	1..2: return item_BR73_1;
		return CB_RESULT_NO_MORE_ARTICULATED_PARTS; }


// unit definition
item (FEAT_TRAINS, item_BR73_1, 7310) {
    property {
        // common properties
        name:                           string(STR_NAME_BR73_1);
        variant_group:                  item_BR73_0; // unit ID or item
		// extra_flags:                    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(1965,01,01); 
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life: 					40;
        retire_early: 					-10;							
        reliability_decay: 				20;
        
		// refittable_cargo_classes:        bitmask(CC_PASSENGERS);
        // non_refittable_cargo_classes:    bitmask();
        cargo_allow_refit:               [PASS, GOOD];
        // cargo_disallow_refit:            [LVST];
        misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
        cargo_capacity:                 1;
        loading_speed:					5;
        running_cost_base:			    RUNNING_COST_STEAM;		

        //specific properties
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        speed:                          90 mph;
        refit_cost:                     0;
        track_type:                     [RAIL, BR_3RDR];
        power:                          600 hp;
        weight:                         78 ton;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        dual_headed:                    0;
        air_drag_coefficient:           0.04;
        tractive_effort_coefficient:    0.24;
        length:                         8;
    }

    graphics {
        // graphics
        default:                        sw_graphics_BR73_1;
        purchase:                       sw_BR73_1_purchase_sprite;
        visual_effect_and_powered:      sw_FX_BR73;
        sound_effect:                   sw_sound_hybrid_73;

        // internal code
        length:                         sw_length_BR73;
        articulated_part:               sw_articulated_BR73_1;
        purchase_cargo_capacity:        0;
        cargo_capacity:                 return 0;
        cost_factor:                    87;
        running_cost_factor:            sw_running_cost_BR73_1;
        cargo_subtype_text:             sw_BR73_1_cargo_subtype_text; 
        power:                          sw_power_BR73_1;
        purchase_power:                 sw_power_BR73_1;
        colour_mapping:                 return PALETTE_CC_FIRST;
    }
}