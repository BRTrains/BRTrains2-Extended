switch(FEAT_TRAINS, PARENT, sw_BR73_0_purchase_sprite, current_year) {
    1948..1965: spriteset_BR73_0_BRGreen_purchase;
    1966..1998: spriteset_BR73_0_BRBlue_YellowFront_purchase;
        spriteset_BR73_0_BRBlue_YellowFront_purchase; }

// FX effects
switch(FEAT_TRAINS, SELF, sw_FX_BR73_Diesel, position_in_vehid_chain % 3) {
    1:  visual_effect_and_powered(VISUAL_EFFECT_DIESEL, -1, DISABLE_WAGON_POWER);
        visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER); }

switch(FEAT_TRAINS, SELF, sw_FX_BR73_Electric, position_in_vehid_chain % 3) { // middle catenary
    1:  electric_create_visual_effect_SAA3;
        visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER); }

switch(FEAT_TRAINS, PARENT, sw_FX_BR73, tile_powers_railtype("BR_3RDR")) {
    1: sw_FX_BR73_Electric;
        sw_FX_BR73_Diesel; }

// dual mode switch
switch(FEAT_TRAINS, PARENT, sw_power_BR73_0, tile_powers_railtype("BR_3RDR")){
    1: 1600;
        600; }

switch(FEAT_TRAINS, PARENT, sw_running_cost_BR73_0, tile_powers_railtype("BR_3RDR")){
    1: 5071;
        3998; }


// livery switch
switch(FEAT_TRAINS, SELF, sw_livery_BR73_0, cargo_subtype) {
    0: spriteset_BR73_0_BRGreen;
    1: spriteset_BR73_0_BRGreen_GreyStripe;
    2: spriteset_BR73_0_BRGreen_SmallYellow;
    3: spriteset_BR73_0_BRBlue_SmallYellow;
    4: spriteset_BR73_0_BRBlue_YellowFront;
    5: spriteset_BR73_0_BRBlue_LargeLogo; }

// livery name refit switch
switch(FEAT_TRAINS, SELF, sw_BR73_0_cargo_subtype_text, cargo_subtype){
	0:	string(STR_LIVERY_EXTENDED, string(str_BR), string(str_col_Green), string(str_BR_LateCrest));
    1:	string(STR_LIVERY_DESC, string(str_BR), string(str_col_Green));
    2:	string(STR_LIVERY_EXTENDED, string(str_BR), string(str_col_Green), string(str_BR_YellowPanel));
    3:  string(STR_LIVERY_EXTENDED, string(str_BR), string(str_col_Blue), string(str_BR_YellowPanel));
    4:  string(STR_LIVERY_EXTENDED, string(str_BR), string(str_col_Blue), string(str_BR_YellowFront));
    5:  string(STR_LIVERY_DESC, string(str_BR), string(str_BR_LLogo));
        CB_RESULT_NO_TEXT; }

// graphics switch
switch(FEAT_TRAINS, SELF, sw_graphics_BR73_0, position_in_articulated_veh % 3) {
	1: return sw_livery_BR73_0;
	    spriteset_empty; }

// length switch
switch(FEAT_TRAINS, SELF, sw_length_BR73, position_in_articulated_veh % 3) {
	1: 2;
	    4; }

// articulation switch
switch(FEAT_TRAINS, SELF, sw_articulated_BR73_0, extra_callback_info1) {
	1..2: return item_BR73_0;
		return CB_RESULT_NO_MORE_ARTICULATED_PARTS; }


// unit definition
item (FEAT_TRAINS, item_BR73_0, 7300) {
    property {
        // common properties
        name:                           string(STR_NAME_BR73_0);
        // variant_group:                  ; // unit ID or item
		// extra_flags:                    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(1962,01,01); 
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life: 					40;
        retire_early: 					-10;							
        reliability_decay: 				20;
        
		// refittable_cargo_classes:        bitmask(CC_PASSENGERS);
        // non_refittable_cargo_classes:    bitmask();
        cargo_allow_refit:               [PASS, GOOD];
        // cargo_disallow_refit:            [LVST];
        misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
        cargo_capacity:                 1;
        loading_speed:					5;
        running_cost_base:			    RUNNING_COST_STEAM;		

        //specific properties
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        speed:                          80 mph;
        refit_cost:                     0;
        track_type:                     [RAIL, BR_3RDR];
        power:                          600 hp;
        weight:                         78 ton;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        dual_headed:                    0;
        air_drag_coefficient:           0.04;
        tractive_effort_coefficient:    0.24;
        length:                         8;
    }

    graphics {
        // graphics
        default:                        sw_graphics_BR73_0;
        purchase:                       sw_BR73_0_purchase_sprite;
        visual_effect_and_powered:      sw_FX_BR73;
        sound_effect:                   sw_sound_hybrid_73;

        // internal code
        length:                         sw_length_BR73;
        articulated_part:               sw_articulated_BR73_0;
        purchase_cargo_capacity:        0;
        cargo_capacity:                 return 0;
        cost_factor:                    81;
        running_cost_factor:            sw_running_cost_BR73_0;
        cargo_subtype_text:             sw_BR73_0_cargo_subtype_text; 
        power:                          sw_power_BR73_0;
        purchase_power:                 sw_power_BR73_0;
        colour_mapping:                 return PALETTE_CC_FIRST;
        // colour_mapping:                 switch_generic_recolour;
    }
}


