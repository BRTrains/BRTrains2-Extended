
// 1923 10t dropside sprite stacks

// 1923 12t sprite stacks
switch(FEAT_TRAINS, SELF, sw_loadstack_RCH_1923_12t_Mixed, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
    0: random_choose_RCH_1923_12t_Mixed;
    1: sw_RCH_1907_7_Plank_cargo_type; }

switch(FEAT_TRAINS, SELF, sw_loadstack_RCH_1923_12t_Grey, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
    0: random_choose_RCH_1923_12t_Grey;
    1: sw_RCH_1907_7_Plank_cargo_type; }

switch(FEAT_TRAINS, SELF, sw_loadstack_RCH_1923_12t_Bauxite, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
    0: random_choose_RCH_1923_12t_Bauxite;
    1: sw_RCH_1907_7_Plank_cargo_type; }

// Random switches
random_switch(FEAT_TRAINS, SELF, random_choose_RCH_1923_Mixed) {
    // 1: sw_loadstack_RCH_1923_random_1_Plank_Cargo;
    // 2: sw_loadstack_RCH_1923_random_3_Plank_Cargo;
    // 5: sw_loadstack_RCH_1923_random_5_Plank_Cargo;
    5: sw_loadstack_RCH_1923_12t_Mixed;
    3: random_choose_RCH_1923_Van_Mixed; }

random_switch(FEAT_TRAINS, SELF, random_choose_RCH_1923_Mixed_Grey) {
    // 1: sw_loadstack_RCH_1923_Grey_1_Plank_Cargo;
    // 2: sw_loadstack_RCH_1923_Grey_3_Plank_Cargo;
    // 5: sw_loadstack_RCH_1923_Grey_5_Plank_Cargo;
    5: sw_loadstack_RCH_1923_12t_Grey;
    3: random_choose_RCH_1923_Van_Grey; }

random_switch(FEAT_TRAINS, SELF, random_choose_RCH_1923_Mixed_Bauxite) {
    // 1: sw_loadstack_RCH_1923_Bauxite_1_Plank_Cargo;
    // 2: sw_loadstack_RCH_1923_Bauxite_3_Plank_Cargo;
    // 5: sw_loadstack_RCH_1923_Bauxite_5_Plank_Cargo;
    5: sw_loadstack_RCH_1923_12t_Bauxite;
    3: random_choose_RCH_1923_Van_Bauxite; }

// livery switch
switch(FEAT_TRAINS, SELF, sw_livery_RCH_1923_Mixed, cargo_subtype) {
    0: random_choose_RCH_1923_Mixed;
    1: random_choose_RCH_1923_Mixed_Grey;
    2: random_choose_RCH_1923_Mixed_Bauxite; }

// livery name refit switch
switch(FEAT_TRAINS, SELF, sw_RCH_1923_Mixed_cargo_subtype_text, cargo_subtype) {
	0:	string(STR_LIVERY, string(str_var_Random));
    1:  string(STR_LIVERY, string(str_col_Grey));
    2:  string(STR_LIVERY, string(str_col_Bauxite));
        CB_RESULT_NO_TEXT; }

// speed switch
switch(FEAT_TRAINS, SELF, sw_speed_RCH_1923, param_max_speed) {
    0: 50; // operational speed
    1: 75; // design speed
}

// unit definition
item (FEAT_TRAINS, item_RCH_1923_Mixed, 11805) {
    property {
        // common properties
        name:                           string(STR_NAME_RCH_1923_Mixed);
        // variant_group:                  ; // unit ID or item
		// extra_flags:                    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(1923,01,01); 
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life: 					40;
        retire_early: 					-10;							
        reliability_decay: 				20;
        
		// refittable_cargo_classes:        bitmask(CC_PASSENGERS);
        refittable_cargo_classes:        bitmask(CC_BULK, CC_PIECE_GOODS, CC_LIQUID, CC_REFRIGERATED, CC_HAZARDOUS, CC_COVERED, CC_POWDERIZED, CC_NEO_BULK, CC_POTABLE);	
        // non_refittable_cargo_classes:    bitmask();
        // cargo_allow_refit:               [PASS, TOUR];
        cargo_allow_refit:              [GOOD];
        cargo_disallow_refit:           [LVST];
        misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
        cargo_capacity:                 12 * param_freight;
        loading_speed:					5;
        running_cost_base:			    RUNNING_COST_STEAM;		

        //specific properties
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        speed:                          50 mph;
        refit_cost:                     0;
        track_type:                     RAIL;
        power:                          0 hp;
        weight:                         9 ton;
        length:                         4;
    }

    graphics {
        // graphics
        default:                        sw_livery_RCH_1923_Mixed;
        purchase:                       spriteset_RCH_1923_12t_Grey_purchase;
        
        // internal code
        speed:                          sw_speed_RCH_1923() * 1609 / 1000;
        cost_factor:                    266;
        running_cost_factor:            453;
        cargo_subtype_text:             sw_RCH_1923_Mixed_cargo_subtype_text; 
        // colour_mapping:                 return PALETTE_CC_FIRST;
        colour_mapping:                 switch_generic_recolour;
    }
}