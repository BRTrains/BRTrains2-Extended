    2:  sw_random_BR_800_Departmental; }

switch(FEAT_TRAINS, SELF, sw_BR_800_FishVan_cargo_subtype_text, cargo_subtype) {
    0:  string(STR_LIVERY_DESC, string(str_BR), string(str_col_White));
    1:  string(STR_LIVERY_DESC, string(str_BR), string(str_col_Blue));
    2:  string(STR_LIVERY_DESC, string(str_BR), string(str_BR_Departmental)); 
        CB_RESULT_NO_TEXT; }


// unit definition
item (FEAT_TRAINS, item_BR_800_FishVan, 12277) {
    property {
        // common properties
        name:                           string(STR_NAME_BR_800_FishVan);
        // variant_group:                  ; // unit ID or item
		// extra_flags:                    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
        // extra_flags:                    bitmask(VEHICLE_FLAG_TRAIN_HAS_CAB);

        climates_available:             ALL_CLIMATES;
        introduction_date:              date(1955,01,01); 
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life: 					40;
        retire_early: 					-10;							
        reliability_decay: 				20;
        
		// refittable_cargo_classes:        bitmask(CC_BULK, CC_PIECE_GOODS, CC_LIQUID, CC_REFRIGERATED, CC_HAZARDOUS, CC_COVERED, CC_OVERSIZED, CC_POWDERIZED, CC_NON_POURABLE, CC_NEO_BULK, CC_POTABLE, CC_NON_POTABLE);	
        // non_refittable_cargo_classes:    bitmask();
        cargo_allow_refit:               [MAIL, GOOD, VALU, GOLD, DIAM, FOOD, FRUT, BEER, FISH, JAVA, MILK, CHSE, CIGR, FRVG, MEAT, OYST, PCL_, TATO, SWET];
        // cargo_disallow_refit:            [LVST];
        default_cargo_type:             FISH;
        misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
        cargo_capacity:                 12 * param_freight;
        loading_speed:				    5; // All freight / Locomotive
        running_cost_base:			    RUNNING_COST_STEAM;		

        //specific properties
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        speed:                          75 mph;
        refit_cost:                     0;
        track_type:                     RAIL;
        weight:                         11 ton;
        dual_headed:                    0;
        length:                         5;
    }

    graphics {
        // graphics
        default:                        sw_livery_BR_800_FishVan;
        purchase:                       sw_BR_800_FishVan_purchase_sprite; // For dual mode units

        // internal code
        cost_factor:                    457;
        running_cost_factor:            945;
        cargo_subtype_text:             sw_BR_800_FishVan_cargo_subtype_text; 
        colour_mapping:                 return PALETTE_CC_FIRST;
    }
}