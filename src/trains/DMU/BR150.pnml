    1969..1998: spriteset_BR150_DMSO_Regional_Railways_purchase;
    1999..2007: spriteset_BR150_DMSO_Central_purchase;
    2016..2030: spriteset_BR150_DMSO_Northern_purchase;
        spriteset_BR150_DMSO_Regional_Railways_purchase;
}

