// livery name refit switch
switch(FEAT_TRAINS, SELF, sw_BR150_cargo_subtype_text, cargo_subtype){
    0:  string(STR_LIVERY_DESC, string(str_BR), string(str_BR_Provincial));
    1:  string(STR_LIVERY_DESC, string(str_BR), string(str_BR_ProvincialPrototype));
    2:  string(STR_LIVERY, string(str_Regional));
    3:  string(STR_LIVERY, string(str_Centro));
    4:  string(STR_LIVERY, string(str_Central));
    5:  string(STR_LIVERY, string(str_GWR));
    6:  string(STR_LIVERY, string(str_Northern));
    7:  string(STR_LIVERY, string(str_TfW));
        CB_RESULT_NO_TEXT; }

// capacity switch
switch(FEAT_TRAINS, SELF, sw_capacity_BR150_0, position_in_vehid_chain % 9) {
    0: 223 * param_pax; // all the capacity - (vehid chain number)
    1..8: 1 * param_pax;
    // total 231
}

// articulation switch
switch(FEAT_TRAINS, SELF, sw_articulated_BR150_0, extra_callback_info1) {
	1..8: return item_BR150_0;
		return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}


// unit definition
item (FEAT_TRAINS, item_BR150_0, 1500) {
    property {
        // common properties
        name:                           string(STR_NAME_BR150_0);
        // variant_group:                  ; // unit ID or item
		extra_flags:                    bitmask(VEHICLE_FLAG_TRAIN_HAS_CAB);
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(1984,01,01); 
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life: 					40;
        retire_early: 					-10;							
        reliability_decay: 				20;
        
		refittable_cargo_classes:        bitmask(CC_PASSENGERS);
        // non_refittable_cargo_classes:    bitmask();
        cargo_allow_refit:               [PASS, TOUR];
        // cargo_disallow_refit:            [LVST];
        misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
        cargo_capacity:                 1;
        // for MUs, loading speed is multiplied by number of carriages * 0.75
        loading_speed:					34; // Standard Class
        running_cost_base:			    RUNNING_COST_STEAM;		

        //specific properties
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        speed:                          75 mph;
        refit_cost:                     0;
        track_type:                     RAIL;
        power:                          858 hp;
        weight:                         107ton;
        engine_class:                   ENGINE_CLASS_DIESEL;
        dual_headed:                    0;
        air_drag_coefficient:           0.04;
        tractive_effort_coefficient:    0.09;
        length:                         4;
    }

    graphics {
        // graphics
        default:                        sw_livery_BR150_0;
        visual_effect_and_powered:      sw_FX_BR150_0_Diesel;
        purchase:                       sw_BR150_purchase_sprite;
        sound_effect:                   sw_sound_diesel_dmu_gen2;

        // internal code
        articulated_part:               sw_articulated_BR150_0;
        purchase_cargo_capacity:        return (25 * param_pax); // divide by number of articulated parts and floor
        cargo_capacity:                 sw_capacity_BR150_0;
        cost_factor:                    197;
        running_cost_factor:            4554;
        cargo_subtype_text:             sw_BR150_cargo_subtype_text; 
        colour_mapping:                 return PALETTE_CC_FIRST;
    }
}


// capacity switch
switch(FEAT_TRAINS, SELF, sw_capacity_BR150_1, position_in_vehid_chain % 6) {
    0: 142 * param_pax; // all the capacity - (vehid chain number)
    1..5: 1 * param_pax;
    // total 147
}

