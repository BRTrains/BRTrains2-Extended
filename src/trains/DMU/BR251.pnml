	0:	string(STR_LIVERY_DESC, string(str_BR), string(str_BR_NankingBlue));
	1:	string(STR_LIVERY_EXTENDED, string(str_BR), string(str_BR_NankingBlue), string(str_BR_YellowFront));
	2:	string(STR_LIVERY_DESC, string(str_BR), string(str_BR_GreyBlue));
