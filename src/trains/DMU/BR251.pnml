    17:     return item_BR_Gen1_MU_B;
		return CB_RESULT_NO_MORE_ARTICULATED_PARTS; }


// unit definition
item (FEAT_TRAINS, item_BR251_6, 2510) {
    property {
        // common properties
        name:                           string(STR_NAME_BR251_6);
        // variant_group:                  ; // unit ID or item
		// extra_flags:                    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
        extra_flags:                    bitmask(VEHICLE_FLAG_TRAIN_HAS_CAB);

        climates_available:             ALL_CLIMATES;
        introduction_date:              date(1960,01,01); 
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life: 					40;
        retire_early: 					-10;							
        reliability_decay: 				20;
        
		refittable_cargo_classes:        bitmask(CC_PASSENGERS);
        // non_refittable_cargo_classes:    bitmask();
        cargo_allow_refit:               [PASS, TOUR];
        // cargo_disallow_refit:            [LVST];
        misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
        cargo_capacity:                 1;
        loading_speed:					80; // Standard Class
        running_cost_base:			    RUNNING_COST_STEAM;		

        //specific properties
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        speed:                          90 mph;
        refit_cost:                     0;
        track_type:                     RAIL;
        power:                          2000 hp;
        weight:                         304 ton;
        engine_class:                   ENGINE_CLASS_DIESEL;
        dual_headed:                    0;
        air_drag_coefficient:           0.07;
        tractive_effort_coefficient:    0.1;
        length:                         8;
    }

    graphics {
        // graphics
        default:                        sw_livery_BR251_6;
        visual_effect_and_powered:      sw_FX_BR251_6_Diesel;
        purchase:                       sw_BR251_6_purchase_sprite;
        sound_effect:                   sw_sound_diesel_25;

        // internal code
        length:                         sw_length_BR251;
        articulated_part:               sw_articulated_BR251_6; 
        purchase_cargo_capacity:        return (7 * param_pax); // divide by number of articulated parts and floor
        cargo_capacity:                 sw_capacity_BR251_6;
        cost_factor:                    198;
        running_cost_factor:            6563;
        cargo_subtype_text:             sw_BR251_cargo_subtype_text; 
        // power:                          sw_power_BR251;
        colour_mapping:                 return PALETTE_CC_FIRST;
        // colour_mapping:                 switch_generic_recolour;
    }
}


