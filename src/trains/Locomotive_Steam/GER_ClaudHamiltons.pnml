    0: sw_Animation_LNER_D16_3_Red;
    1: sw_Animation_LNER_D16_3;
    2: sw_Animation_LNER_D16_3;
    3: sw_Animation_LNER_D16_3; }

switch(FEAT_TRAINS, SELF, sw_spritestack_LNER_D16_3, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
    0: sw_livery_LNER_D16_3;
    1: sw_animation_livery_LNER_D16_3; }

// livery name refit switch
switch(FEAT_TRAINS, SELF, sw_LNER_D16_3_cargo_subtype_text, cargo_subtype){
	0:	string(STR_LIVERY_DESC, string(str_GER), string(str_col_Blue));
    1:  string(STR_LIVERY_DESC, string(str_GER), string(str_col_Black));
    2:  string(STR_LIVERY_DESC, string(str_LNER), string(str_LNER_AppleGreen));
    3:  string(STR_LIVERY_DESC, string(str_LNER), string(str_col_Black));
        CB_RESULT_NO_TEXT; }


// graphics switch
switch(FEAT_TRAINS, SELF, sw_graphics_LNER_D16_3, position_in_articulated_veh % 2) {
	0: sw_spritestack_LNER_D16_3;
	1: sw_livery_GER_S46_Tender; }

// length switch
switch(FEAT_TRAINS, SELF, sw_length_LNER_D16_3, position_in_articulated_veh % 2) {
	0: 6;
	1: 4; }


// articulation switch
switch(FEAT_TRAINS, SELF, sw_articulated_LNER_D16_3, extra_callback_info1) {
	1: return item_LNER_D16_3;
		return CB_RESULT_NO_MORE_ARTICULATED_PARTS; }


// unit definition
item (FEAT_TRAINS, item_LNER_D16_3, 6253) {
    property {
        // common properties
        name:                           string(STR_NAME_LNER_D16_3);
        variant_group:                  item_GER_S46; // unit ID or item
		
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(1900,01,01); 
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life: 					40;
        retire_early: 					-10;							
        reliability_decay: 				20;
        
		// refittable_cargo_classes:        bitmask(CC_PASSENGERS);
        // non_refittable_cargo_classes:    bitmask();
        cargo_allow_refit:               [PASS, GOOD];
        // cargo_disallow_refit:            [LVST];
        misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
        cargo_capacity:                 1;
        loading_speed:				    5; // All freight / Locomotive
        running_cost_base:			    RUNNING_COST_STEAM;		

        //specific properties
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        speed:                          85 mph;
        refit_cost:                     0;
        track_type:                     RAIL;
        power:                          1225 hp;
        weight:                         85 ton;
        engine_class:                   ENGINE_CLASS_STEAM;
        dual_headed:                    0;
        air_drag_coefficient:           0.04;
        tractive_effort_coefficient:    0.11;
        length:                         8;
    }

    graphics {
        // graphics
        default:                        sw_graphics_LNER_D16_3;
        visual_effect_and_powered:      sw_FX_GER_S46_Steam;
        purchase:                       sw_spritestack_LNER_D16_3_purchase;
        sound_effect:                   sw_sound_steam_generic;

        // internal code
        length:                         sw_length_LNER_D16_3;
        articulated_part:               sw_articulated_LNER_D16_3; 
        purchase_cargo_capacity:        0;
        cargo_capacity:                 return 0;
        cost_factor:                    76;
        running_cost_factor:            4876;
        cargo_subtype_text:             sw_LNER_D16_3_cargo_subtype_text; 
        colour_mapping:                 return PALETTE_CC_FIRST;
    }
}