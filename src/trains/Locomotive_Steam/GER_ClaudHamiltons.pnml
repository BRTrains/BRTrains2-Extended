    3: spriteset_LNER_D16_3_Red_Anim4; }

switch(FEAT_TRAINS, SELF, sw_LNER_D16_3_purchase_sprite, current_year) {
    1901..1923: spriteset_LNER_D16_3_GER_Blue_purchase;
    1924..1948: spriteset_LNER_D16_3_LNER_Green_purchase;
        spriteset_LNER_D16_3_GER_Blue_purchase; }

switch(FEAT_TRAINS, SELF, sw_LNER_D16_3_anim_purchase_sprite, current_year) {
    1901..1923: spriteset_LNER_D16_3_Red_Anim_purchase;
    1924..1948: spriteset_LNER_D16_3_LNER_Green_purchase;
        spriteset_LNER_D16_3_Red_Anim_purchase; }

switch(FEAT_TRAINS, SELF, sw_spritestack_LNER_D16_3_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
    0: sw_LNER_D16_3_purchase_sprite;
    1: sw_LNER_D16_3_anim_purchase_sprite; }

// livery switch
switch(FEAT_TRAINS, SELF, sw_livery_LNER_D16_3, cargo_subtype) {
    0: spriteset_LNER_D16_3_GER_Blue;
    1: spriteset_LNER_D16_3_GER_Black;
    2: spriteset_LNER_D16_3_LNER_Green;
    3: spriteset_LNER_D16_3_LNER_Black; }

