// unit definition
item (FEAT_TRAINS, item_GER_S46, 6250) {
    property {
        // common properties
        name:                           string(STR_NAME_GER_S46);
        // variant_group:                  ; // unit ID or item
		
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(1900,01,01); 
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life: 					40;
        retire_early: 					-10;							
        reliability_decay: 				20;
        
		// refittable_cargo_classes:        bitmask(CC_PASSENGERS);
        // non_refittable_cargo_classes:    bitmask();
        cargo_allow_refit:               [PASS, GOOD];
        // cargo_disallow_refit:            [LVST];
        misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
        cargo_capacity:                 1;
        loading_speed:				    5; // All freight / Locomotive
        running_cost_base:			    RUNNING_COST_STEAM;		

        //specific properties
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        speed:                          70 mph;
        refit_cost:                     0;
        track_type:                     RAIL;
        power:                          940 hp;
        weight:                         81 ton;
        engine_class:                   ENGINE_CLASS_STEAM;
        dual_headed:                    0;
        air_drag_coefficient:           0.05;
        tractive_effort_coefficient:    0.1;
        length:                         8;
    }

    graphics {
        // graphics
        default:                        sw_graphics_GER_S46;
        visual_effect_and_powered:      sw_FX_GER_S46_Steam;
        purchase:                       sw_GER_S46_purchase_sprite;
        sound_effect:                   sw_sound_steam_generic;

        // internal code
        name:                           sw_GER_S46_name;
        length:                         sw_length_GER_S46;
        articulated_part:               sw_articulated_GER_S46; 
        purchase_cargo_capacity:        0;
        cargo_capacity:                 return 0;
        cost_factor:                    42;
        running_cost_factor:            2911;
        cargo_subtype_text:             sw_GER_S46_cargo_subtype_text; 
        colour_mapping:                 return PALETTE_CC_FIRST;
    }
}

