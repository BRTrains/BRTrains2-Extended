switch(FEAT_TRAINS, SELF, sw_animation_LMS_Ivatt_2, motion_counter % 4) {
    0: spriteset_LMS_Ivatt_2_Anim1;
    1: spriteset_LMS_Ivatt_2_Anim2;
    2: spriteset_LMS_Ivatt_2_Anim3;
    3: spriteset_LMS_Ivatt_2_Anim4; }


switch(FEAT_TRAINS, PARENT, sw_LMS_Ivatt_2_purchase_sprite, current_year) {
    1924..1948: spriteset_LMS_Ivatt_2_LMS_Unlined_Black_purchase;
        spriteset_LMS_Ivatt_2_BR_Lined_Black_purchase; }

switch(FEAT_TRAINS, SELF, sw_spritestack_LMS_Ivatt_2_purchase, [ STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8) ] ) {
    0: sw_LMS_Ivatt_2_purchase_sprite;
    1: spriteset_LMS_Ivatt_2_Anim_purchase; }


// livery switch
switch(FEAT_TRAINS, SELF, sw_livery_LMS_Ivatt_2, cargo_subtype) {
    0: spriteset_LMS_Ivatt_2_LMS_Unlined_Black;
    1: spriteset_LMS_Ivatt_2_BR_Unlined_Black;
    2: spriteset_LMS_Ivatt_2_BR_Unlined_Black;
    3: spriteset_LMS_Ivatt_2_BR_Lined_Black;
    4: spriteset_LMS_Ivatt_2_BR_Lined_Black;
    5: spriteset_LMS_Ivatt_2_BR_Lined_Green_Named;
    6: spriteset_LMS_Ivatt_2_BR_Lined_Green;
    7: spriteset_LMS_Ivatt_2_BR_Crimson; }

switch(FEAT_TRAINS, SELF, sw_livery_LMS_Ivatt_2_Tender, cargo_subtype) {
    0: spriteset_LMS_Ivatt_3000gal_LMS_Unlined_Black;
    1: spriteset_LMS_Ivatt_3000gal_BR_Unlined_Black_Early;
    2: spriteset_LMS_Ivatt_3000gal_BR_Unlined_Black_Late;
    3: spriteset_LMS_Ivatt_3000gal_BR_Lined_Black_Early;
    4: spriteset_LMS_Ivatt_3000gal_BR_Lined_Black_Late;
    5: spriteset_LMS_Ivatt_3000gal_BR_Lined_Green_Early;
    6: spriteset_LMS_Ivatt_3000gal_BR_Lined_Green_Late;
    7: spriteset_LMS_Ivatt_3000gal_BR_Crimson; }

// livery name refit switch
switch(FEAT_TRAINS, SELF, sw_LMS_Ivatt_2_cargo_subtype_text, cargo_subtype){
	0:	return string(str_BRCrimson);
    1:  return string(str_BRPlainBlack_Early);
    2:  return string(str_BRPlainBlack_Late);
    3:  return string(str_BRLinedBlack_Early);
    4:  return string(str_BRLinedBlack_Late);
    5:  return string(str_BRGreen_Early);
    6:  return string(str_BRGreen_Late);
    7:  return string(str_BRCrimson);
       return CB_RESULT_NO_TEXT; }

// Animation sprite stacking
switch(FEAT_TRAINS, SELF, sw_spritestack_LMS_Ivatt_2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
    0: sw_livery_LMS_Ivatt_2;
    1: sw_animation_LMS_Ivatt_2; }

// graphics switch
switch(FEAT_TRAINS, SELF, sw_graphics_LMS_Ivatt_2, position_in_articulated_veh % 2) {
	0: sw_spritestack_LMS_Ivatt_2;
	1: sw_livery_LMS_Ivatt_2_Tender; }

// length switch
switch(FEAT_TRAINS, SELF, sw_length_LMS_Ivatt_2, position_in_articulated_veh % 2) {
	0: 6;
	1: 4; }


// articulation switch
switch(FEAT_TRAINS, SELF, sw_articulated_LMS_Ivatt_2, extra_callback_info1) {
	1: return item_LMS_Ivatt_2;
		return CB_RESULT_NO_MORE_ARTICULATED_PARTS; }


// unit definition
item (FEAT_TRAINS, item_LMS_Ivatt_2, 4640) {
    property {
        // common properties
        name:                           string(STR_NAME_LMS_Ivatt_2);

        climates_available:             ALL_CLIMATES;
        introduction_date:              date(1946,01,01); 
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life: 					40;
        retire_early: 					-10;							
        reliability_decay: 				20;
        
		// refittable_cargo_classes:        bitmask(CC_PASSENGERS);
        // non_refittable_cargo_classes:    bitmask();
        cargo_allow_refit:               [PASS, GOOD];
        // cargo_disallow_refit:            [LVST];
        misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
        cargo_capacity:                 1;
        loading_speed:				    5; // All freight / Locomotive
        running_cost_base:			    RUNNING_COST_STEAM;		

        //specific properties
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        speed:                          75 mph;
        refit_cost:                     0;
        track_type:                     RAIL;
        power:                          1045 hp;
        weight:                         97 ton;
        engine_class:                   ENGINE_CLASS_STEAM;
        dual_headed:                    0;
        air_drag_coefficient:           0.04;
        tractive_effort_coefficient:    0.09;
        length:                         8;
    }

    graphics {
        // graphics
        default:                        sw_graphics_LMS_Ivatt_2;
        // visual_effect_and_powered:      sw_FX_LMS_Ivatt_2_Diesel;
        // visual_effect_and_powered:      sw_FX_LMS_Ivatt_2_Electric;
        // visual_effect_and_powered:      sw_FX_LMS_Ivatt_2_Steam;
        purchase:                       sw_spritestack_LMS_Ivatt_2_purchase; // For dual mode units
        // sound_effect:                   ;

        // internal code
        length:                         sw_length_LMS_Ivatt_2;
        articulated_part:               sw_articulated_LMS_Ivatt_2;
        purchase_cargo_capacity:        0;
        cargo_capacity:                 return 0;
        cost_factor:                    66;
        running_cost_factor:            4232;
        cargo_subtype_text:             sw_LMS_Ivatt_2_cargo_subtype_text; 
        colour_mapping:                 return PALETTE_CC_FIRST;

        // purchase menu text
        additional_text:                return( string(str_purchase_loco_with_liveries,
                                                    string(str_purchase_type_steam),
                                                    string(str_usage_mixed_traffic),
                                                    string(str_LMS_Ivatt_2_liveries)));
    }
}

