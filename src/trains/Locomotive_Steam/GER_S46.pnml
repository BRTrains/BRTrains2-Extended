    { template_68trains_4x(0,0) }

switch(FEAT_TRAINS, SELF, sw_animation_GER_S46, motion_counter % 4) {
    0: spriteset_empty;
    1: spriteset_GER_S46_Anim2;
    2: spriteset_empty;
    3: spriteset_empty; }

// FX effects
switch(FEAT_TRAINS, SELF, sw_FX_GER_S46_Steam, position_in_vehid_chain % 2) {
    0:  visual_effect_and_powered(VISUAL_EFFECT_STEAM, -2, DISABLE_WAGON_POWER);
        visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER); }

switch(FEAT_TRAINS, SELF, sw_GER_S46_purchase_sprite, current_year) {
    1901..1923: spriteset_GER_S46_GER_Blue_purchase;
    1924..1948: spriteset_GER_S46_LNER_Green_purchase;
        spriteset_GER_S46_GER_Blue_purchase; }

// livery switch
switch(FEAT_TRAINS, SELF, sw_livery_GER_S46, cargo_subtype) {
    0: spriteset_GER_S46_GER_Blue;
    1: spriteset_GER_S46_GER_Black;
    2: spriteset_GER_S46_LNER_Green;
    3: spriteset_GER_S46_LNER_Black; }

switch(FEAT_TRAINS, SELF, sw_livery_GER_S46_Tender, cargo_subtype) {
    0: spriteset_GER_3450gal_GER_Blue;
    1: spriteset_GER_3450gal_GER_Black;
    2: spriteset_GER_3450gal_LNER_Green;
    3: spriteset_GER_3450gal_LNER_Black; }

switch(FEAT_TRAINS, SELF, sw_spritestack_GER_S46, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
    0: sw_livery_GER_S46;
    1: sw_animation_GER_S46; }

// livery name refit switch
switch(FEAT_TRAINS, SELF, sw_GER_S46_cargo_subtype_text, cargo_subtype){
	0:	return string(str_GERBlue);
    1:  return string(str_GERBlack);
    2:  return string(str_LNERAppleGreen);
    3:  return string(str_LNERBlack);
       return CB_RESULT_NO_TEXT;
}


// graphics switch
switch(FEAT_TRAINS, SELF, sw_graphics_GER_S46, position_in_articulated_veh % 2) {
	0: sw_spritestack_GER_S46;
	1: sw_livery_GER_S46_Tender; }

// length switch
switch(FEAT_TRAINS, SELF, sw_length_GER_S46, position_in_articulated_veh % 2) {
	0: 6;
	1: 4; }


// articulation switch
switch(FEAT_TRAINS, SELF, sw_articulated_GER_S46, extra_callback_info1) {
	1: return item_GER_S46;
		return CB_RESULT_NO_MORE_ARTICULATED_PARTS; }


// unit definition
item (FEAT_TRAINS, item_GER_S46, ) {
    property {
        // common properties
        name:                           string(STR_NAME_GER_S46);
        // variant_group:                  ; // unit ID or item
		// extra_flags:                    bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
        // extra_flags:                    bitmask(VEHICLE_FLAG_TRAIN_HAS_CAB);

        climates_available:             ALL_CLIMATES;
        introduction_date:              date(1900,01,01); 
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life: 					40;
        retire_early: 					-10;							
        reliability_decay: 				20;
        
		// refittable_cargo_classes:        bitmask(CC_PASSENGERS);
        // refittable_cargo_classes:        bitmask(CC_EXPRESS);
        // refittable_cargo_classes:        bitmask(CC_BULK, CC_PIECE_GOODS, CC_LIQUID, CC_REFRIGERATED, CC_HAZARDOUS, CC_COVERED, CC_OVERSIZED, CC_POWDERIZED, CC_NON_POURABLE, CC_NEO_BULK, CC_POTABLE, CC_NON_POTABLE);	
        // non_refittable_cargo_classes:    bitmask();
        // cargo_allow_refit:               [PASS, TOUR];
        cargo_allow_refit:               [PASS, GOOD];
        // cargo_allow_refit:               [MAIL, GOOD, VALU];
        // cargo_disallow_refit:            [LVST];
        misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
        cargo_capacity:                 1;
        loading_speed:				    5; // All freight / Locomotive
        running_cost_base:			    RUNNING_COST_STEAM;		

        //specific properties
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        speed:                          80 mph;
        refit_cost:                     0;
        track_type:                     RAIL;
        power:                          940 hp;
        weight:                         81 ton;
        engine_class:                   ENGINE_CLASS_STEAM;
        dual_headed:                    0;
        air_drag_coefficient:           0.04;
        tractive_effort_coefficient:    0.1;
        length:                         8;
    }

    graphics {
        // graphics
        default:                        sw_graphics_GER_S46;
        visual_effect_and_powered:      sw_FX_GER_S46_Steam;
        purchase:                       sw_GER_S46_purchase_sprite;
        sound_effect:                   sw_sound_steam_generic;

        // internal code
        length:                         sw_length_GER_S46;
        articulated_part:               sw_articulated_GER_S46; 
        purchase_cargo_capacity:        0;
        cargo_capacity:                 return 0;
        cost_factor:                    45;
        running_cost_factor:            3130;
        cargo_subtype_text:             sw_GER_S46_cargo_subtype_text; 
        colour_mapping:                 return PALETTE_CC_FIRST;

        // purchase menu text
        additional_text:                return( string(str_purchase_loco_with_liveries,
                                                    string(str_purchase_type_steam),
                                                    string(str_usage_expr_pax),
                                                    string(str_GER_S46_liveries)));
    }
}